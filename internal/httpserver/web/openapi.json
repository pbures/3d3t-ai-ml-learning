              "schema": { "$ref": "#/components/schemas/CreateGameRequest" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created game state linked to the battle",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/GameStateDTO" }
              }
            }
          },
          "400": {
            "description": "Invalid JSON or unknown opponent_agent",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "404": {
            "description": "Battle not found",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          }
        }
      }
    },
    "/api/v1/games": {
      "get": {
        "tags": ["Games & Programmatic Play"],
        "summary": "List all active and completed games (optionally filtered by battle_id)",
        "operationId": "listGames",
        "parameters": [
          {
            "name": "battle_id",
            "in": "query",
            "required": false,
            "description": "Optional battle ID to filter games belonging to a specific battle",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Array of game summaries sorted by game_id",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["games"],
                  "properties": {
                    "games": {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/GameSummaryDTO" }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["Games & Programmatic Play"],
        "summary": "Create a new game session (with custom match name and optional AI opponent)",
        "description": "Creates a new 3T3D match. You can provide a human-friendly match `name` (e.g. `\"Qualifying Match #1 — Laptop Bot vs TTT3DNet\"`), a custom `game_id`, `white_name`, `black_name`, and optionally an `opponent_agent` (`\"ttt3dnet\"`, `\"ttt3dnet-pure\"`, `\"mcts\"`, `\"alphabeta\"`, `\"heuristic\"`, `\"random\"`). If `opponent_agent` is set and `human_player` is `2` (Black), the server AI automatically makes the opening White move (`move_count = 1`) before returning!",
        "operationId": "createGame",
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CreateGameRequest" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created game state",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/GameStateDTO" }
              }
            }
          },
          "400": {
            "description": "Invalid JSON or unknown opponent_agent",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          }
        }
      }
    },
    "/api/v1/games/{id}": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "description": "Unique game session identifier (`game_id`)",
          "schema": { "type": "string" }
        }
      ],
      "get": {
        "tags": ["Games & Programmatic Play"],
        "summary": "Get full game state and move history by ID",
        "operationId": "getGame",
        "responses": {
          "200": {
            "description": "Full game state and replay history",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/GameStateDTO" }
              }
            }
          },
          "404": {
            "description": "Game not found",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          }
        }
      },
      "patch": {
        "tags": ["Games & Programmatic Play"],
        "summary": "Rename a match or update player names / opponent model",
        "operationId": "updateGameMetadata",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/UpdateGameRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated game state",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/GameStateDTO" }
              }
            }
          },
          "400": {
            "description": "Invalid request payload",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "404": {
            "description": "Game not found",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          }
        }
      }
    },
    "/api/v1/games/{id}/move": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "description": "Unique game session identifier (`game_id`)",
          "schema": { "type": "string" }
        }
      ],
      "post": {
        "tags": ["Games & Programmatic Play"],
        "summary": "Submit a move from an external player/algorithm (with optional immediate AI reply)",
        "description": "Applies a column move for the current player. You may specify either `action` (`0..15`) or `use_coords: true` with `x` (`0..3`) and `y` (`0..3`). If the game was created with an `opponent_agent` (or if you pass `opponent_agent` in this request body), and the game is still `ONGOING` after your move, the server automatically computes and applies the AI opponent's reply and returns it in `ai_move` alongside the updated `state`.",
        "operationId": "submitMove",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/MoveRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Move applied (and optional AI reply executed)",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/MoveResponseDTO" }
              }
            }
          },
          "400": {
            "description": "Out-of-bounds action/coordinates, full column, or invalid JSON",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "404": {
            "description": "Game not found",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "409": {
            "description": "Game already over or out-of-turn player",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          }
        }
      }
    },
    "/api/v1/games/{id}/ai-move": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "description": "Unique game session identifier (`game_id`)",
          "schema": { "type": "string" }
        }
      ],
      "post": {
        "tags": ["Games & Programmatic Play"],
        "summary": "Trigger a move by one of the implemented AI models on the current game",
        "operationId": "triggerAIMove",
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/AIMoveRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "AI move applied",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/MoveResponseDTO" }
              }
            }
          },
          "400": {
            "description": "Unknown AI agent name",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "404": {
            "description": "Game not found",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "409": {
            "description": "Game already finished",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          }
        }
      }
    },
    "/api/v1/games/{id}/reset": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "description": "Unique game session identifier (`game_id`)",
          "schema": { "type": "string" }
        }
      ],
      "post": {
        "tags": ["Games & Programmatic Play"],
        "summary": "Reset a game session back to an empty 4x4x4 board",
        "operationId": "resetGame",
        "responses": {
          "200": {
            "description": "Reset game state",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/GameStateDTO" }
              }
            }
          }
        }
      }
    },
    "/api/v1/games/{id}/preset": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "description": "Unique game session identifier (`game_id`)",
          "schema": { "type": "string" }
        }
      ],
      "post": {
        "tags": ["Games & Programmatic Play"],
        "summary": "Load a deterministic preset replay (win line 0..75 or 64-move draw)",
        "operationId": "applyPreset",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/PresetRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Game state after applying preset sequence",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/GameStateDTO" }
              }
            }
          },
          "400": {
            "description": "Invalid preset parameters",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          }
        }
      }
    },
    "/api/v1/bots/{agent}/move": {
      "parameters": [
        {
          "name": "agent",
          "in": "path",
          "required": true,
          "description": "Built-in model identifier (`ttt3dnet`, `ttt3dnet-pure`, `mcts`, `alphabeta`, `heuristic`, `random`)",
          "schema": {
            "type": "string",
            "enum": ["ttt3d-deep-gray1", "ttt3d-deep-gray1-pure", "deep", "ttt3dnet", "ttt3dnet-pure", "mcts", "alphabeta", "heuristic", "random"]
          }
        }
      ],
      "post": {
        "tags": ["AI Models & Webhooks"],
        "summary": "Stateless AI model evaluation webhook",
        "description": "Accepts a `GameStateDTO` JSON payload and returns the chosen `{\"action\": 0..15}` for the specified built-in model without mutating any server session.",
        "operationId": "evaluateBotMove",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/GameStateDTO" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Selected column action",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/MoveRequest" }
              }
            }
          },
          "400": {
            "description": "Invalid state payload or unknown agent",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "409": {
            "description": "No legal moves in terminal board state",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          }
        }
      }
    },
    "/api/v1/matches/run": {
      "post": {
        "tags": ["AI Models & Webhooks"],
        "summary": "Orchestrate a full automated match between webhooks or built-in AI models",
        "description": "Runs a complete match from start to finish and records it for 3D replay. Each side can be specified either as a remote webhook URL (`white_bot_url` / `black_bot_url`) **or** as a built-in model name (`white_agent` / `black_agent`, e.g. `\"ttt3dnet\"`, `\"mcts\"`, `\"alphabeta\"`, `\"heuristic\"`, `\"random\"`).",
        "operationId": "runMatch",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/RunMatchRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Completed match state with full move history",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/GameStateDTO" }
              }
            }
          },
          "400": {
            "description": "Missing bot URLs/agents or invalid agent name",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "502": {
            "description": "Remote webhook bot returned an error, timed out, or attempted an illegal move",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ErrorResponse": {
        "type": "object",
        "required": ["error"],
        "properties": {
          "error": { "type": "string", "example": "invalid action" }
        }
      },
      "ModelInfoDTO": {
        "type": "object",
        "required": ["id", "name", "type", "description"],
        "properties": {
          "id": { "type": "string", "example": "ttt3dnet" },
          "name": { "type": "string", "example": "TTT3DNet Hybrid (3D ResNet + 2-Ply Tactical Shield)" },
          "type": { "type": "string", "enum": ["neural_hybrid", "neural_pure", "search", "heuristic", "baseline"] },
          "description": { "type": "string" }
        }
      },
      "CoordDTO": {
        "type": "object",
        "required": ["action", "x", "y", "z"],
        "properties": {
          "action": { "type": "integer", "minimum": 0, "maximum": 15 },
          "x": { "type": "integer", "minimum": 0, "maximum": 3 },
          "y": { "type": "integer", "minimum": 0, "maximum": 3 },
          "z": { "type": "integer", "minimum": 0, "maximum": 3 },
          "player": { "type": "integer", "enum": [1, 2] },
          "move_number": { "type": "integer", "minimum": 1, "maximum": 64 }
        }
      },
      "WinLineDTO": {
        "type": "object",
        "required": ["index", "category", "mask", "coords"],
        "properties": {
          "index": { "type": "integer", "minimum": 0, "maximum": 75 },
          "category": { "type": "string" },
          "mask": { "type": "integer" },
          "coords": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/CoordDTO" }
          }
        }
      },
      "CreateBattleRequest": {
        "type": "object",
        "properties": {
          "battle_id": { "type": "string", "example": "battle-alpha-1" },
          "name": { "type": "string", "example": "Evening Showdown vs TTT3DNet" },
          "date": { "type": "string", "example": "2026-11-12T21:45:00Z" },
          "participant": { "type": "string", "example": "MyLaptopBot" },
          "client_name": { "type": "string", "example": "MyLaptopBot" },
          "opponent_agent": {
            "type": "string",
            "enum": ["", "ttt3dnet", "ttt3dnet-pure", "mcts", "alphabeta", "heuristic", "random"]
          }
        }
      },
      "UpdateBattleRequest": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "date": { "type": "string" },
          "participant": { "type": "string" },
          "client_name": { "type": "string" },
          "opponent_agent": { "type": "string" }
        }
      },
      "BattleSummaryDTO": {
        "type": "object",
        "required": [
          "battle_id",
          "name",
          "date",
          "participant",
          "client_name",
          "total_games",
          "completed_games",
          "ongoing_games",
          "client_wins",
          "server_wins",
          "draws",
          "client_win_rate",
          "server_win_rate",
          "client_score_rate",
          "winner_side",
          "winner_label",
          "game_ids"
        ],
        "properties": {
          "battle_id": { "type": "string", "example": "battle-1" },
          "name": { "type": "string", "example": "Evening Showdown vs TTT3DNet" },
          "date": { "type": "string", "example": "2026-11-12T21:45:00Z" },
          "participant": { "type": "string", "example": "MyLaptopBot" },
          "client_name": { "type": "string", "example": "MyLaptopBot" },
          "opponent_agent": { "type": "string", "example": "ttt3dnet" },
          "total_games": { "type": "integer" },
          "completed_games": { "type": "integer" },
          "ongoing_games": { "type": "integer" },
          "client_wins": { "type": "integer" },
          "server_wins": { "type": "integer" },
          "draws": { "type": "integer" },
          "client_win_rate": { "type": "number", "format": "double" },
          "server_win_rate": { "type": "number", "format": "double" },
          "client_score_rate": { "type": "number", "format": "double" },
          "winner_side": { "type": "string", "enum": ["CLIENT", "SERVER", "TIE", "ONGOING"] },
          "winner_label": { "type": "string", "example": "CLIENT (MyLaptopBot)" },
          "game_ids": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      },
      "BattleDetailDTO": {
        "allOf": [
          { "$ref": "#/components/schemas/BattleSummaryDTO" },
          {
            "type": "object",
            "required": ["games"],
            "properties": {
              "games": {
                "type": "array",
                "items": { "$ref": "#/components/schemas/GameSummaryDTO" }
              }
            }
          }
        ]
      },
      "GameSummaryDTO": {
        "type": "object",
        "required": [
          "game_id",
          "battle_id",
          "name",
          "participant",
          "client_name",
          "client_player",
          "server_player",
          "winner_side",
          "winner_label",
          "white_name",
          "black_name",
          "status",
          "winner",
          "move_count",
          "current_player"
        ],
        "properties": {
          "game_id": { "type": "string", "example": "match-alpha-1" },
          "battle_id": { "type": "string", "example": "battle-1" },
          "battle_name": { "type": "string", "example": "Evening Showdown vs TTT3DNet" },
          "name": { "type": "string", "example": "CW - Qualifying Match #1 — MyBot vs TTT3DNet" },
          "participant": { "type": "string", "example": "MyLaptopBot" },
          "client_name": { "type": "string", "example": "MyLaptopBot" },
          "client_player": { "type": "integer", "enum": [1, 2] },
          "server_player": { "type": "integer", "enum": [1, 2] },
          "winner_side": { "type": "string", "enum": ["CLIENT", "SERVER", "DRAW", "ONGOING"] },
          "winner_label": { "type": "string", "example": "CLIENT (MyLaptopBot)" },
          "white_name": { "type": "string", "example": "MyExternalBot (White)" },
          "black_name": { "type": "string", "example": "TTT3DNet (Black)" },
          "opponent_agent": { "type": "string", "example": "ttt3dnet" },
          "status": { "type": "string", "enum": ["ONGOING", "WHITE_WON", "BLACK_WON", "DRAW"] },
          "winner": { "type": "integer", "enum": [0, 1, 2] },
          "move_count": { "type": "integer", "minimum": 0, "maximum": 64 },
          "current_player": { "type": "integer", "enum": [1, 2] }
        }
      },
      "GameStateDTO": {
        "type": "object",
        "required": [
          "game_id",
          "battle_id",
          "name",
          "participant",
          "client_name",
          "client_player",
          "server_player",
          "winner_side",
          "winner_label",
          "white_name",
          "black_name",
          "white_bitboard",
          "black_bitboard",
          "current_player",
          "status",
          "status_code",
          "winner",
          "win_line_mask",
          "win_line_index",
          "valid_moves_mask",
          "valid_actions",
          "move_count",
          "board",
          "canonical_tensor",
          "history"
        ],
        "properties": {
          "game_id": { "type": "string", "example": "match-alpha-1" },
          "battle_id": { "type": "string", "example": "battle-1" },
          "battle_name": { "type": "string", "example": "Evening Showdown vs TTT3DNet" },
          "name": { "type": "string", "example": "CW - Qualifying Match #1 — MyBot vs TTT3DNet" },
          "participant": { "type": "string", "example": "MyLaptopBot" },
          "client_name": { "type": "string", "example": "MyLaptopBot" },
          "client_player": { "type": "integer", "enum": [1, 2] },
          "server_player": { "type": "integer", "enum": [1, 2] },
          "winner_side": { "type": "string", "enum": ["CLIENT", "SERVER", "DRAW", "ONGOING"] },
          "winner_label": { "type": "string", "example": "CLIENT (MyLaptopBot)" },
          "white_name": { "type": "string", "example": "MyExternalBot" },
          "black_name": { "type": "string", "example": "TTT3DNet" },
          "opponent_agent": { "type": "string", "example": "ttt3dnet" },
          "white_bitboard": { "type": "integer" },
          "black_bitboard": { "type": "integer" },
          "current_player": { "type": "integer", "enum": [1, 2] },
          "status": { "type": "string", "enum": ["ONGOING", "WHITE_WON", "BLACK_WON", "DRAW"] },
          "status_code": { "type": "integer", "enum": [0, 1, 2, 3] },
          "winner": { "type": "integer", "enum": [0, 1, 2] },
          "win_line_mask": { "type": "integer" },
          "win_line_index": { "type": "integer" },
          "win_line_category": { "type": "string" },
          "win_line_coords": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/CoordDTO" }
          },
          "valid_moves_mask": { "type": "integer", "minimum": 0, "maximum": 65535 },
          "valid_actions": {
            "type": "array",
            "items": { "type": "integer", "minimum": 0, "maximum": 15 }
          },
          "move_count": { "type": "integer", "minimum": 0, "maximum": 64 },
          "board": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "type": "array",
                "items": { "type": "integer" }
              }
            }
          },
          "canonical_tensor": {
            "type": "array",
            "items": { "type": "integer" }
          },
          "history": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/CoordDTO" }
          }
        }
      },
      "CreateGameRequest": {
        "type": "object",
        "properties": {
          "game_id": { "type": "string", "example": "my-algo-match-01" },
          "battle_id": { "type": "string", "example": "battle-1" },
          "name": { "type": "string", "example": "Championship Game 1 — MyBot vs TTT3DNet" },
          "participant": { "type": "string", "example": "MyLaptopBot" },
          "client_name": { "type": "string", "example": "MyLaptopBot" },
          "white_name": { "type": "string", "example": "MyLaptopBot (White)" },
          "black_name": { "type": "string", "example": "TTT3DNet (Black)" },
          "opponent_agent": {
            "type": "string",
            "enum": ["", "ttt3dnet", "ttt3dnet-pure", "mcts", "alphabeta", "heuristic", "random"]
          },
          "human_player": { "type": "integer", "enum": [1, 2] },
          "client_player": { "type": "integer", "enum": [1, 2] }
        }
      },
      "UpdateGameRequest": {
        "type": "object",
        "properties": {
          "battle_id": { "type": "string" },
          "name": { "type": "string" },
          "participant": { "type": "string" },
          "client_name": { "type": "string" },
          "client_player": { "type": "integer", "enum": [1, 2] },
          "white_name": { "type": "string" },
          "black_name": { "type": "string" },
          "opponent_agent": { "type": "string" }
        }
      },
      "MoveRequest": {
        "type": "object",
        "properties": {
          "player": { "type": "integer", "enum": [1, 2] },
          "action": { "type": "integer", "minimum": 0, "maximum": 15 },
          "use_coords": { "type": "boolean" },
          "x": { "type": "integer", "minimum": 0, "maximum": 3 },
          "y": { "type": "integer", "minimum": 0, "maximum": 3 },
          "opponent_agent": { "type": "string" },
          "auto_reply": { "type": "boolean" }
        }
      },
      "MoveResponseDTO": {
        "type": "object",
        "required": ["state", "last_move", "reward", "done"],
        "properties": {
          "state": { "$ref": "#/components/schemas/GameStateDTO" },
          "last_move": { "$ref": "#/components/schemas/CoordDTO" },
          "ai_move": { "$ref": "#/components/schemas/CoordDTO" },
          "reward": { "type": "number", "format": "float" },
          "done": { "type": "boolean" }
        }
      },
      "AIMoveRequest": {
        "type": "object",
        "properties": {
          "agent": {
            "type": "string",
            "enum": ["ttt3dnet", "ttt3dnet-pure", "mcts", "alphabeta", "heuristic", "random"],
            "example": "ttt3dnet"
          }
        }
      },
      "PresetRequest": {
        "type": "object",
        "required": ["type"],
        "properties": {
          "type": { "type": "string", "enum": ["win", "draw"] },
          "line_index": { "type": "integer", "minimum": 0, "maximum": 75 },
          "winner": { "type": "integer", "enum": [1, 2] }
        }
      },
      "RunMatchRequest": {
        "type": "object",
        "properties": {
          "game_id": { "type": "string" },
          "battle_id": { "type": "string" },
          "name": { "type": "string", "example": "Bot Showdown — TTT3DNet vs MCTS" },
          "participant": { "type": "string" },
          "client_name": { "type": "string" },
          "client_player": { "type": "integer", "enum": [1, 2] },
          "white_name": { "type": "string" },
          "black_name": { "type": "string" },
          "white_bot_url": { "type": "string" },
          "black_bot_url": { "type": "string" },
          "white_agent": { "type": "string" },
          "black_agent": { "type": "string" },
          "timeout_ms": { "type": "integer", "default": 5000 }
        }
      }
    }
  }
}
