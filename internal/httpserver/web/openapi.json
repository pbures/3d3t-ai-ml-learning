      }
    },
    "/api/v1/battles": {
      "get": {
        "tags": ["Battles & Statistics"],
        "summary": "List all battles with aggregate Client vs Server statistics",
        "operationId": "listBattles",
        "responses": {
          "200": {
            "description": "Array of battle summaries",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["battles"],
                  "properties": {
                    "battles": {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/BattleSummaryDTO" }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["Battles & Statistics"],
        "summary": "Create a new battle with name, date, and participant (client player)",
        "operationId": "createBattle",
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CreateBattleRequest" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created battle detail and initial statistics",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/BattleDetailDTO" }
              }
            }
          },
          "400": {
            "description": "Invalid JSON or unknown opponent_agent",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          }
        }
      }
    },
    "/api/v1/battles/{id}": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "description": "Unique battle identifier (`battle_id`)",
          "schema": { "type": "string" }
        }
      ],
      "get": {
        "tags": ["Battles & Statistics"],
        "summary": "Get battle statistics, winner (Client vs Server), and all games in the battle",
        "operationId": "getBattle",
        "responses": {
          "200": {
            "description": "Battle metadata, aggregate statistics, winner, and games list",
