        "responses": {
          "200": {
            "description": "MCP server metadata and available tools",
            "content": {
              "application/json": {
                "schema": { "type": "object" }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["System & Discovery"],
        "summary": "Model Context Protocol (MCP) JSON-RPC 2.0 Streamable HTTP endpoint",
        "description": "Accepts MCP JSON-RPC 2.0 requests (`initialize`, `tools/list`, `tools/call`, `resources/list`, `resources/read`, `ping`) to control the 3T3D Arena API via MCP tools.",
        "operationId": "postMCPRPC",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "type": "object" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "MCP JSON-RPC 2.0 response",
            "content": {
              "application/json": {
                "schema": { "type": "object" }
              }
            }
          }
        }
      }
    },
