              }
            }
          }
        }
      },
      "patch": {
        "tags": ["Battles & Statistics"],
        "summary": "Update battle name, date, participant (client player), or default AI model",
        "operationId": "updateBattle",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/UpdateBattleRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated battle detail and statistics",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/BattleDetailDTO" }
              }
            }
          },
          "400": {
            "description": "Invalid request payload",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "404": {
            "description": "Battle not found",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          }
        }
      }
    },
    "/api/v1/battles/{id}/games": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "description": "Unique battle identifier (`battle_id`)",
          "schema": { "type": "string" }
        }
      ],
      "get": {
        "tags": ["Battles & Statistics"],
        "summary": "List all games and aggregate statistics for a battle",
        "operationId": "listBattleGames",
        "responses": {
          "200": {
            "description": "Battle details and games",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/BattleDetailDTO" }
              }
            }
          },
          "404": {
            "description": "Battle not found",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["Battles & Statistics"],
        "summary": "Create a new game inside an existing battle",
        "operationId": "createBattleGame",
        "requestBody": {
          "required": false,
